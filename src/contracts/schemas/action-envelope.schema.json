{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-proof-lab.invalid/schemas/action-envelope.json",
  "title": "C3 ActionEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "action_id", "tenant_id", "actor_id", "connection_ref", "operation", "idempotency_key", "input",
    "authorization_decision", "policy_version", "requested_at"
  ],
  "properties": {
    "run_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "action_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "tenant_id": { "type": "string", "pattern": "^T_[A-Z0-9_]+$" },
    "actor_id": { "type": "string", "pattern": "^([UW][A-Z0-9_]+|system:worker)$" },
    "connection_ref": { "enum": ["local:slack:A", "local:slack:B", "local:floci", "local:crm-double"] },
    "operation": { "enum": ["ticket.create", "receipt.put", "approval.request", "approval.resolve", "crm.description.update", "slack.reply"] },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 },
    "input": { "type": "object" },
    "authorization_decision": { "enum": ["allow", "deny"] },
    "policy_version": { "type": "string", "minLength": 1 },
    "requested_at": { "type": "string", "minLength": 20 },
    "expected_version": { "type": "integer", "minimum": 0 },
    "approval_ref": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "ticket.create" } }, "required": ["operation"] },
      "then": { "properties": { "input": { "type": "object", "additionalProperties": false, "required": ["summary", "source_event_id"],
        "properties": { "summary": { "type": "string", "minLength": 1, "maxLength": 200 }, "source_event_id": { "type": "string", "minLength": 1 } } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "receipt.put" } }, "required": ["operation"] },
      "then": { "properties": { "input": { "type": "object", "additionalProperties": false, "required": ["bucket", "key", "sha256", "subject_action_id"],
        "properties": { "bucket": { "type": "string" }, "key": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "subject_action_id": { "type": "string" } } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "approval.request" } }, "required": ["operation"] },
      "then": { "properties": { "input": { "type": "object", "additionalProperties": false, "required": ["item", "amount_cents"],
        "properties": { "item": { "type": "string", "minLength": 1, "maxLength": 120 }, "amount_cents": { "type": "integer", "minimum": 0, "maximum": 10000000 } } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "approval.resolve" } }, "required": ["operation"] },
      "then": { "required": ["approval_ref"], "properties": { "input": { "type": "object", "additionalProperties": false, "required": ["approval_id", "request_digest", "resolution"],
        "properties": { "approval_id": { "type": "string" }, "request_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "resolution": { "enum": ["approved", "rejected"] } } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "crm.description.update" } }, "required": ["operation"] },
      "then": { "required": ["expected_version"], "properties": { "input": { "type": "object", "additionalProperties": false, "required": ["account_id", "description"],
        "properties": { "account_id": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1, "maxLength": 255 } } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "slack.reply" } }, "required": ["operation"] },
      "then": { "properties": { "input": { "type": "object", "additionalProperties": false, "required": ["channel", "thread_ts", "text"],
        "properties": { "channel": { "type": "string" }, "thread_ts": { "type": "string" }, "text": { "type": "string", "maxLength": 4000 } } } } }
    }
  ]
}
