  "cards": [
    {
      "dot": "emerald",
      "title": "Happy path (F3-A1)",
      "items": [
        "Architecture, not execution evidence; the run is C-05 in docs/CLAIM_LEDGER.md.",
        "One ticket, one S3 receipt matching the request, one reply in the original thread.",
        "The reply is written only in the transaction that commits the receipt."
      ]
    },
    {
      "dot": "rose",
      "title": "Failure branches",
      "items": [
        "Forged or stale signature: 401, no inbox row (G-SIG, G-OLD).",
        "Duplicate delivery or redelivered job: no second ticket or reply (W01-D, W01-Q).",
        "S3 PUT fails: ticket kept, no success reply (W01-S).",
        "Receipt gone after a success reply: the collector sees it, so FAIL (W01-F, F4-A1).",
        "Reply timeout after send: UNKNOWN, never blindly re-posted (W01-T)."
      ]
    },
